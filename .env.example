# ハローワーク求人情報提供API（利用申請・承認後に発行された値を設定）
HELLOWORK_API_BASE_URL=
HELLOWORK_API_USER_ID=
HELLOWORK_API_PASSWORD=

# 民間職業紹介事業者向け・神奈川県一般求人
HELLOWORK_DATA_ID=M114

# 1回の表示で確認する最大ページ数（1ページ最大1,000件）
HELLOWORK_MAX_PAGES=6

# 問い合わせ自動送信（RESEND_API_KEYはCloudflareで暗号化シークレットとして設定）
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Ridgeline <onboarding@resend.dev>"
CONTACT_TO_EMAIL=sugita@kameya-hldgs.com

# 管理画面の署名キー（Cloudflareで暗号化シークレットとして設定）
ADMIN_SESSION_SECRET=
